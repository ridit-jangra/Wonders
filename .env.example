# Postgres connection string for the wonders-db database on Orchard
DATABASE_URL=

HC_AUTH_CLIENT_ID=
HC_AUTH_CLIENT_SECRET=

HC_AUTH_REDIRECT_URI=http://localhost:3000/api/hc-auth/callback

SESSION_SECRET=

SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# eg 12341,124124,124124
ADMIN_SLACK_IDS=
APP_ORIGINS=

PII_ENCRYPTION_KEY=

ADMIN_HC_AUTH_REDIRECT_URI=

HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
HACKATIME_REDIRECT_URI=http://localhost:3000/api/hackatime/callback

# The automatic check right after a player ships. Without a key the repo, demo
# and README checks still run, only the AI README check and notes are skipped.
HACKCLUB_CDN_API_KEY=
OPENROUTER_API_KEY=
AI_REVIEW_MODEL=anthropic/claude-opus-5.5
# set to "off" to skip the automatic check entirely
AI_PRECHECK=
# optional, raises GitHub's limit from 60 to 5000 requests an hour (each ship uses about 4)
GITHUB_TOKEN=

# Staff Slack alerts (stale queue pings and the Monday summary). Defaults are fine.
STAFF_ALERT_CHANNEL_ID=C0C6E5XN45C
QUEUE_STALE_HOURS=72
# set to "off" to stop the background alert jobs
STAFF_JOBS=
APP_URL=https://wonders.hackclub.com

# Send grant on /admin/fulfillment (HCB card grants). HCB_ORG_ID is the org slug.
# HCB_ACCESS_TOKEN must be a never-expiring token of an HCB user who can create
# card grants on that org (an HCB admin makes it eternal).
HCB_ORG_ID=
HCB_ACCESS_TOKEN=
HCB_GRANT_MAX_CENTS=50000

# Where queue rows open for review, with {id} for the wonder id (e.g. https://uri.example/review/{id}).
REVIEW_TOOL_URL=
